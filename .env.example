# --- Frontend (copy the relevant lines into app/.env.local) ---
VITE_NWLHS_SUPABASE_URL=
VITE_NWLHS_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8787

# --- Worker secrets (set with `wrangler secret put <NAME>` from /worker — do not commit real values) ---
NWLHS_SUPABASE_URL=
NWLHS_SUPABASE_SERVICE_ROLE_KEY=
DMEMZ_SUPABASE_URL=
DMEMZ_SUPABASE_SERVICE_ROLE_KEY=

# --- Used starting Phase 2+ (fal.ai generation pipeline) ---
FAL_KEY=
# Any random long string -- signs the short-lived media URLs that let
# fal.ai fetch a training image from R2 without exposing the bucket.
MEDIA_SIGNING_SECRET=

# --- Worker non-secret vars (set directly in worker/wrangler.toml [vars]; shown here for reference) ---
APP_ORIGIN=http://localhost:5173
PUBLIC_MEDIA_BASE_URL=http://localhost:8787
